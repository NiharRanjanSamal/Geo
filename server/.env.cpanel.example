# cPanel Production Environment
# Copy to .env and fill in your values

NODE_ENV=production
PORT=3000

# MySQL (from cPanel → MySQL Databases)
# Username and database are often prefixed with your cPanel user (e.g. zenuser_dbname)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=zenuser_attendance_user
MYSQL_PASSWORD=nihar@5855
MYSQL_DATABASE=your_cpanel_database

# JWT - Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_strong_random_secret

# Frontend URL (for password reset links)
FRONTEND_URL=https://attendance.zenuino.in

# CORS - Comma-separated allowed origins (optional)
CORS_ORIGIN=https://attendance.zenuino.in
